{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "k2-status",
	"main": "./worker.ts",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
		},
	},
	// One probe pass per minute; incidents open after three consecutive failures.
	"triggers": {
		"crons": ["* * * * *"],
	},
	// Deliberately independent from the main worker: the status page must stay
	// up when main-app deploys break or the app D1 database is down, so it
	// has its own domain and its own Durable Object storage.
	"routes": [
		{
			"pattern": "k2-status.pruett.in",
			"custom_domain": true,
		},
	],
	"services": [
		{
			// Worker-to-worker only. Not a public jobs hostname.
			"binding": "JOBS",
			"service": "k2-jobs",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "STATUS_STORE",
				"class_name": "StatusStore",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["StatusStore"],
		},
	],
	// Named favicon PNGs. `/` has no index.html, so the worker still
	// renders the page. `/favicon.ico` is worker-handled and 302s to the
	// current overall-status file.
	"assets": {
		"directory": "./public",
		"html_handling": "none",
		"not_found_handling": "none",
	},
	"vars": {
		"PRIMARY_ORIGIN": "https://k2.pruett.in",
		// k2: the package-app origin (PACKAGE_APP_BASE_URL in
		// packages/worker/wrangler.jsonc); probes the runtime Worker there.
		"PACKAGE_APP_ORIGIN": "https://pruett.xyz",
		"STATUS_PAGE_URL": "https://k2-status.pruett.in",
		// k2: alert emails off until an operator address is set.
		"ALERT_EMAIL_TO": "",
		"ALERT_EMAIL_FROM": "kody@k2.pruett.in",
		"STATUS_ALERT_DAILY_LIMIT": "6",
		// Grok Bot woken directly on incident open and all-clear. The webhook URL
		// and bearer are Worker secrets STATUS_GROK_BOT_WAKE_URL and
		// STATUS_GROK_BOT_WAKE_TOKEN, synced by the deploy workflow when present.
		"STATUS_GROK_BOT_ID": "6519d644-b6ac-4e61-989c-3d96d0b63cca",
		"STATUS_GROK_BOT_NAME": "cole",
		"STATUS_GROK_BOT_WAKE_DAILY_LIMIT": "12",
		// Production Kody Cloudflare account (same as the main worker); the
		// matching CLOUDFLARE_API_TOKEN (Email Sending only) is a Worker secret
		// the deploy workflow syncs from CLOUDFLARE_STATUS_API_TOKEN.
		// k2: CLOUDFLARE_ACCOUNT_ID is passed at deploy (--var), not committed.
		"BUILD_COMMIT": "REPLACE_AT_DEPLOY_TIME",
	},
}
